# Timing variant of p15_cask4_fuel0_neutron.mac.
# Loads 10^6 surface entries and normalises to about 9.6e5 generated primaries.
/control/verbose 0
/run/verbose 0
/tracking/verbose 0
/event/verbose 0
/process/verbose 0

/run/numberOfThreads 8
/dcs-monitor/det/useBiasing false
/dcs-monitor/det/setBiasingShells 1

/dcs-monitor/det/setRotation 0 0 0
/dcs-monitor/det/setPosition 1580 1580 0 mm
/dcs-monitor/det/castor440/add
/dcs-monitor/det/setPosition 1580 -1580 0 mm
/dcs-monitor/det/castor440/add
/dcs-monitor/det/setPosition -1580 1580 0 mm
/dcs-monitor/det/castor440/add
/dcs-monitor/det/setPosition -1580 -1580 0 mm
/dcs-monitor/det/castor440/add
/dcs-monitor/det/setPosition 6240 1580 0 mm
/dcs-monitor/det/castor440/add
/dcs-monitor/det/setPosition 6240 -1580 0 mm
/dcs-monitor/det/castor440/add
/dcs-monitor/det/setPosition 9400 1580 0 mm
/dcs-monitor/det/castor440/add
/dcs-monitor/det/setPosition 9400 -1580 0 mm
/dcs-monitor/det/castor440/add
/dcs-monitor/det/setPosition -6240 1580 0 mm
/dcs-monitor/det/castor440/add
/dcs-monitor/det/setPosition -6240 -1580 0 mm
/dcs-monitor/det/castor440/add
/dcs-monitor/det/setPosition -9400 1580 0 mm
/dcs-monitor/det/castor440/add
/dcs-monitor/det/setPosition -9400 -1580 0 mm
/dcs-monitor/det/castor440/add

/dcs-monitor/det/setPosition 0 0 0 mm
/dcs-monitor/det/setRotation 0 0 0
/dcs-monitor/det/hall/add
/dcs-monitor/det/hall/setLength 22000 mm
/dcs-monitor/det/hall/setWallInnerY 5410 mm
/dcs-monitor/det/hall/setFloorTopZ -2040 mm
/dcs-monitor/det/hall/setUseCeiling false

/run/initialize

/dcs-monitor/gun/sourceMode CASTOR440_surface_from_TTree
/dcs-monitor/surf/sourcePid 2112
/dcs-monitor/surf/smearPhi 0.005
/dcs-monitor/surf/smearZ 10.0 mm
/dcs-monitor/surf/smearAngle 0.02
/dcs-monitor/surf/smearEfrac 0.0
/dcs-monitor/surf/sourceFile /home/turko46/bigdata/DCS-Monitor-II/turko46/SurfaceFlux_v3/neutron_Watt/using/surface_neutron-Watt-a-0p85-b-3p4_fuel0_nShells10_nEvts1000000.root
/dcs-monitor/surf/maxEntriesLoadedFromTree 1000000

/dcs-monitor/run/writePrimary false
/dcs-monitor/run/writeSurfaceFlux false

/dcs-monitor/surf/caskNum 4
/dcs-monitor/surf/sourceRotZ 0 deg
/dcs-monitor/surf/globalFuel 0
/dcs-monitor/surf/batchId 0
/dcs-monitor/surf/sourceType 0
/dcs-monitor/surf/decayRate 4.16e6
/dcs-monitor/surf/numPrimaries 1000000

/analysis/setFileName /home/turko46/geant4-sims/G4DCSmonitor/build/validation/p15_cask4_fuel0_neutron_quick
/dcs-monitor/surf/startRun 18 s
