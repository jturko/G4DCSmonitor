# =============================================================================
# muon_vis_wls_ogl.mac -- head-less OpenGL (TSG_OFFSCREEN) geometry-only renders
# of the Config-4 setup (multi-clad fibres, white clamp). Same tuned viewpoints
# as macros/muon_vis_wls_closeup.mac, rendered with Geant4's own OpenGL driver.
# These complement the hand-made VRML screenshots (muonScint_WLS_*.png).
#
# NOTE: this uses the *tessellated* preset 5, not the production analytic preset
# 7. The two are geometrically equivalent (same round Ø1.0 mm fibres, same clamp
# and grease volumes), but the OpenGL/TSG renderer can only draw a Boolean solid
# whose cutter implements CreatePolyhedron(): the analytic cutter is a G4CutTubs
# which does NOT, so the clamp/grease fall back to a point cloud; the tessellated
# cutter is a G4TessellatedSolid which DOES, so the clamp/grease render as solids.
# (The physics runs still use the analytic preset 7.)
#
#   ./build/G4DCSmonitor macros/muon_vis_wls_ogl.mac
#
# Writes report/figures/wls_ogl_<tag>.png:
#   overview  (a) whole plate, the -x clamp strip and the -y read-out sensor
#   xsection  (b) cross-section: slab | grease | four multi-clad fibre discs | clamp
#   readout   (c) the -y read-out end: fibre bundle coupled onto the SiPM
#   length    (d) oblique on the -x face: fibres run the full plate length in y
#
# Colours match the event display: scintillator light blue, grease amber, fibre
# core pale green, cladding green, clamp dark grey, SiPM red.  No beam-on.
# =============================================================================

/run/numberOfThreads 1

# ---- geometry: plate + Config 4 WLS fibre clamp (tessellated vis variant, preset 5)
/dcs-monitor/det/setPosition 0 0 0 mm
/dcs-monitor/det/setRotation 0 0 0
/dcs-monitor/det/muonScint/add
/dcs-monitor/det/muonScint/setSize 250 250 10 mm
/dcs-monitor/det/muonScint/preset 5
/dcs-monitor/det/muonScint/setReflector 3
/dcs-monitor/det/muonScint/setWrap true

/run/initialize

# ---- head-less offscreen rendering (no GUI) ---------------------------------
/vis/open TSG_OFFSCREEN 2000x1500
/vis/tsg/offscreen/set/format zb_png
/vis/tsg/offscreen/set/size 1200 1200

/vis/verbose errors
/vis/viewer/set/autoRefresh false
/vis/viewer/set/background white
/vis/drawVolume
/vis/viewer/set/style surface
/vis/viewer/set/edge false
/vis/viewer/set/auxiliaryEdge false
/vis/viewer/set/upVector 0 0 1
/vis/tsg/offscreen/set/transparency true

# --- (a) overview: plate with the -x clamp strip and the -y read-out sensor --
/vis/tsg/offscreen/set/file report/figures/wls_ogl_overview.png
/vis/viewer/set/viewpointThetaPhi 80 250
/vis/viewer/set/targetPoint -80 0 0 mm
/vis/viewer/zoomTo 3.0
/vis/viewer/flush

# --- (b) x-z cross-section through the clamp (slab | grease | fibres | clamp) -
/vis/tsg/offscreen/set/file report/figures/wls_ogl_xsection.png
/vis/viewer/set/viewpointThetaPhi 90 90
/vis/viewer/set/targetPoint -125.6 0 0 mm
/vis/viewer/zoomTo 28
/vis/viewer/flush

# --- (c) read-out end at -y: fibre bundle coupled onto the single SiPM -------
/vis/tsg/offscreen/set/file report/figures/wls_ogl_readout.png
/vis/viewer/set/viewpointThetaPhi 60 285
/vis/viewer/set/targetPoint -125.8 -118 0 mm
/vis/viewer/zoomTo 20
/vis/viewer/flush

# --- (d) oblique on the -x face: the four fibres run the full length in y ----
/vis/tsg/offscreen/set/file report/figures/wls_ogl_length.png
/vis/viewer/set/viewpointThetaPhi 35 200
/vis/viewer/set/targetPoint -125.8 0 0 mm
/vis/viewer/zoomTo 4
/vis/viewer/flush
