# =============================================================================
# MuonScint scenario template -- FAST variant (Rao et al., J. Appl. Phys. 138, 114504)
#
# Identical to muon_scint_template.mac EXCEPT the optional per-slab optical
# track-length flux map is OFF.  Measurements on an 8-thread box showed the map
# triples the runtime (0.70 -> 0.23 s/event); the photon budget and the
# collection efficiency both come from opticalStats + the sipmHits tree, so the
# map is not needed for the yield comparison.  Turn it back on only if you
# specifically want h2_optflux_xy_slab<i>.
#
# Vertical 4 GeV muon pencil beam (50 x 50 mm^2) striking the
# 250 x 250 x 10 mm^3 plastic plate.  One process covers ONE (config, reflector)
# pair and runs all THREE beam positions back-to-back after a single
# /run/initialize.
#
#   CONFIG    : 1 = 8 SiPMs (2/side), 2 = 4 SiPMs (1/side), 3 = 2 SiPMs (1 side)
#   REFLECTOR : 0 = none (held in black holder), 1 = TiO2 paint,
#               2 = aluminium foil, 3 = high-gloss paper
#   POSITION  : centre, edge (middle of +Y side), corner (+X/+Y)
#
# This file is a template.  Do NOT edit the generated macros -- edit this.
# =============================================================================

/run/numberOfThreads 8

# ---- geometry: plate + SiPM layout + reflector ------------------------------
/dcs-monitor/det/setPosition 0 0 0 mm
/dcs-monitor/det/setRotation 0 0 0
/dcs-monitor/det/muonScint/add
/dcs-monitor/det/muonScint/setSize 250 250 10 mm
/dcs-monitor/det/muonScint/preset 1
/dcs-monitor/det/muonScint/setReflector 1
/dcs-monitor/det/muonScint/setWrap true

/run/initialize

# ---- per-slab optical-photon x-y track-length flux map: OFF (fast variant) ---
# /dcs-monitor/run/writeOpticalFluxMap true

# ---- primary: vertical 4 GeV muon, 50 x 50 mm^2 beam ------------------------
/dcs-monitor/gun/sourceMode GPS
/gps/particle mu-
/gps/ene/type Mono
/gps/ene/mono 4 GeV
/gps/pos/type Plane
/gps/pos/shape Square
/gps/pos/halfx 25 mm
/gps/pos/halfy 25 mm
/gps/ang/type planar

# ---- position 1/3: centre ---------------------------------------------------
/analysis/setFileName /home/turko46/geant4-sims/G4DCSmonitor/slurm/data_output/muon_out_c1_r1_centre.root
/gps/pos/centre 0 0 100 mm
/run/beamOn 1000

# ---- position 2/3: edge (middle of +X side, fully on the slab) --------------
# The 50x50 mm beam is centred 25 mm inside the +X edge so the illuminated
# 50x50 mm patch lies entirely on the plate ([75,125] mm), matching the MCD
# active area and the equal-area centre region.
/analysis/setFileName /home/turko46/geant4-sims/G4DCSmonitor/slurm/data_output/muon_out_c1_r1_edge.root
/gps/pos/centre 100 0 100 mm
/run/beamOn 1000

# ---- position 3/3: corner (+X/+Y, fully on the slab) ------------------------
/analysis/setFileName /home/turko46/geant4-sims/G4DCSmonitor/slurm/data_output/muon_out_c1_r1_corner.root
/gps/pos/centre 100 100 100 mm
/run/beamOn 1000
