\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces Position resolution of the config-1 read-out, from the whole-plate irradiation of the $v6$ campaign (\num {25000} events per wrapper, \num {20000} for training and \num {5000} held out). The entries are the rms of the reconstruction error along one transverse axis, in millimetres; $\sigma _r$ is the rms of the radial error of the best channel and $r_{68}$ its 68\,\% containment radius. The four information channels are the \emph  {pulse integral} (the eight shares of the total collected charge), the \emph  {arrival time} (the eight first-arrival times, relative to the event mean), the \emph  {prompt fraction} (the eight shares of the charge that arrived before \SI {3}{\nano \second }) and their combination.}}{49}{table.caption.42}\protected@file@percent }
\newlabel{tab:recon}{{12}{49}{Position resolution of the config-1 read-out, from the whole-plate irradiation of the $v6$ campaign (\num {25000} events per wrapper, \num {20000} for training and \num {5000} held out). The entries are the rms of the reconstruction error along one transverse axis, in millimetres; $\sigma _r$ is the rms of the radial error of the best channel and $r_{68}$ its 68\,\% containment radius. The four information channels are the \emph {pulse integral} (the eight shares of the total collected charge), the \emph {arrival time} (the eight first-arrival times, relative to the event mean), the \emph {prompt fraction} (the eight shares of the charge that arrived before \SI {3}{\nano \second }) and their combination}{table.caption.42}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {31}{\ignorespaces Rms radial reconstruction error of the config-1 read-out for the four information channels and the four wrapper treatments, on the held-out events of the whole-plate irradiation. The channels are mutually complementary: the diffuse TiO$_2$ paint is localised by the light sharing (the pulse integrals) alone, the two specular wrappers by the arrival-time pattern alone, and the contact-limited bare plate needs both. Combining the channels does not help in every case, because the extra dimensions dilute the distance metric of the $k$-nearest-neighbour search.}}{50}{figure.caption.43}\protected@file@percent }
\newlabel{fig:recon-feat}{{31}{50}{Rms radial reconstruction error of the config-1 read-out for the four information channels and the four wrapper treatments, on the held-out events of the whole-plate irradiation. The channels are mutually complementary: the diffuse TiO$_2$ paint is localised by the light sharing (the pulse integrals) alone, the two specular wrappers by the arrival-time pattern alone, and the contact-limited bare plate needs both. Combining the channels does not help in every case, because the extra dimensions dilute the distance metric of the $k$-nearest-neighbour search}{figure.caption.43}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.5}Response and resolution map}{50}{subsection.8.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {32}{\ignorespaces Position response of the learned estimator for the four wrappers (rows: the two transverse coordinates; columns: the wrapper). Each point is the mean reconstructed position in a \SI {25}{\milli \meter } bin of the true position, with the rms error of the bin as a vertical bar; the dashed line is the one-to-one line. The estimator is the best channel of Table~\ref {tab:recon}. The response is linear over most of the plate, with a systematic pull towards the plate centre at the edges---an artefact of the $k$-nearest-neighbour estimator, not of the detector.}}{51}{figure.caption.44}\protected@file@percent }
\newlabel{fig:recon-resp}{{32}{51}{Position response of the learned estimator for the four wrappers (rows: the two transverse coordinates; columns: the wrapper). Each point is the mean reconstructed position in a \SI {25}{\milli \meter } bin of the true position, with the rms error of the bin as a vertical bar; the dashed line is the one-to-one line. The estimator is the best channel of Table~\ref {tab:recon}. The response is linear over most of the plate, with a systematic pull towards the plate centre at the edges---an artefact of the $k$-nearest-neighbour estimator, not of the detector}{figure.caption.44}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {33}{\ignorespaces Map of the rms radial reconstruction error of the config-1 read-out over the plate, in \SI {25}{\milli \meter } cells, for the four wrappers (each panel on its own colour scale). The black squares mark the SiPM positions and the bold rectangle the slab outline. The resolution is best in the interior and degrades towards the corners, where the interaction point is furthest from most sensors.}}{52}{figure.caption.45}\protected@file@percent }
\newlabel{fig:recon-map}{{33}{52}{Map of the rms radial reconstruction error of the config-1 read-out over the plate, in \SI {25}{\milli \meter } cells, for the four wrappers (each panel on its own colour scale). The black squares mark the SiPM positions and the bold rectangle the slab outline. The resolution is best in the interior and degrades towards the corners, where the interaction point is furthest from most sensors}{figure.caption.45}{}}
