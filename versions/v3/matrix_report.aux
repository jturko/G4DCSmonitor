\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Bare-plate contact-fraction scan. The first three panels show the mean photoelectron yield versus contact fraction $f$ for configs~1--3, with the centre, edge and corner patches as separate curves and the corresponding matrix TiO$_2$ reference as a dashed line in the same colour. A full diamond marks the interpolated crossing where the bare yield falls below TiO$_2$; the crossing fractions are listed, colour-matched to the curves, in the empty upper-right corner of each of the first three panels. The bottom-right panel shows the centre yield normalised to $f=0$, with the centre crossing fractions of configs~1--3 listed in the region between the unity line and the curves. The contact model is a mean-field per-hit loss ($R=1-f$, $T=0$), so $f$ is an effective area fraction, not a measured holder contact area.}}{21}{figure.caption.13}\protected@file@percent }
\newlabel{fig:contact}{{10}{21}{Bare-plate contact-fraction scan. The first three panels show the mean photoelectron yield versus contact fraction $f$ for configs~1--3, with the centre, edge and corner patches as separate curves and the corresponding matrix TiO$_2$ reference as a dashed line in the same colour. A full diamond marks the interpolated crossing where the bare yield falls below TiO$_2$; the crossing fractions are listed, colour-matched to the curves, in the empty upper-right corner of each of the first three panels. The bottom-right panel shows the centre yield normalised to $f=0$, with the centre crossing fractions of configs~1--3 listed in the region between the unity line and the curves. The contact model is a mean-field per-hit loss ($R=1-f$, $T=0$), so $f$ is an effective area fraction, not a measured holder contact area}{figure.caption.13}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Config-1 centre contact-fraction scan. $\ensuremath  {N_{\mathrm  {pe}}}$ is the mean photoelectron yield per event with its statistical uncertainty, $Y(f)/Y(0)$ is normalised to the air-gap value, and $\Delta $ is the signed difference from the matrix TiO$_2$ reference (\num {124.12}~pe/event). The production nominal is $f=\num {0.045}$.}}{22}{table.caption.14}\protected@file@percent }
\newlabel{tab:contact}{{4}{22}{Config-1 centre contact-fraction scan. $\pe $ is the mean photoelectron yield per event with its statistical uncertainty, $Y(f)/Y(0)$ is normalised to the air-gap value, and $\Delta $ is the signed difference from the matrix TiO$_2$ reference (\num {124.12}~pe/event). The production nominal is $f=\num {0.045}$}{table.caption.14}{}}
