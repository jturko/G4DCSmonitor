\@writefile{toc}{\contentsline {subsection}{\numberline {7.2}Arrival times and pulse persistence}{42}{subsection.7.2}\protected@file@percent }
\newlabel{sec:timing}{{7.2}{42}{Arrival times and pulse persistence}{subsection.7.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {26}{\ignorespaces Arrival-time persistence map of the detected photoelectrons, one panel per layout (glossy paper, whole-plate irradiation). The abscissa is the global arrival time, the ordinate the number of photoelectrons in the corresponding \SI {0.1}{\nano \second } time bin (summed over the layout's SiPMs), and the colour the number of events reaching that point (shared logarithmic scale). Empty time bins are omitted; the ordinate is shared across the four panels and linear over $0$--$30$ photoelectrons per bin ($1$ p.e.\ per bin), the arrival-time axis over $0$--$60$ ns. The prompt rise reflects the direct scintillation and \v {C}erenkov light, while the slower tail is the multi-bounce transport and delayed (self-absorbed and re-emitted) light. The prompt peak of configs~1--3 extends above the shared ordinate and is therefore clipped; the WLS layout (config~4) builds up roughly \SI {6.0}{\nano \second } later than the others, its prompt peak shifted by the fibre absorption and re-emission.}}{43}{figure.caption.36}\protected@file@percent }
\newlabel{fig:persistence}{{26}{43}{Arrival-time persistence map of the detected photoelectrons, one panel per layout (glossy paper, whole-plate irradiation). The abscissa is the global arrival time, the ordinate the number of photoelectrons in the corresponding \SI {0.1}{\nano \second } time bin (summed over the layout's SiPMs), and the colour the number of events reaching that point (shared logarithmic scale). Empty time bins are omitted; the ordinate is shared across the four panels and linear over $0$--$30$ photoelectrons per bin ($1$ p.e.\ per bin), the arrival-time axis over $0$--$60$ ns. The prompt rise reflects the direct scintillation and \v {C}erenkov light, while the slower tail is the multi-bounce transport and delayed (self-absorbed and re-emitted) light. The prompt peak of configs~1--3 extends above the shared ordinate and is therefore clipped; the WLS layout (config~4) builds up roughly \SI {6.0}{\nano \second } later than the others, its prompt peak shifted by the fibre absorption and re-emission}{figure.caption.36}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {27}{\ignorespaces Average arrival-time waveform of the detected photoelectrons, one curve per layout (glossy paper, whole-plate irradiation), obtained by averaging the per-event traces of Fig.~\ref {fig:persistence} over events. The abscissa is the global arrival time and the ordinate the mean number of photoelectrons in each \SI {0.1}{\nano \second } bin per event. The left panel uses a linear ordinate and the right a logarithmic one; all four configurations are drawn on each panel (the prompt peaks of configs~1--3 nearly coincide and extend above the linear range). The integrated mean yields are \num {518.8}, \num {274.0}, \num {140.2} and \num {67.5} photoelectrons per event for configs~1--4. The WLS layout (config~4) peaks roughly \SI {6.0}{\nano \second } later than the others and retains a long, slowly-decaying tail, the average-waveform counterpart of the persistence map.}}{44}{figure.caption.37}\protected@file@percent }
\newlabel{fig:avgwaveform}{{27}{44}{Average arrival-time waveform of the detected photoelectrons, one curve per layout (glossy paper, whole-plate irradiation), obtained by averaging the per-event traces of Fig.~\ref {fig:persistence} over events. The abscissa is the global arrival time and the ordinate the mean number of photoelectrons in each \SI {0.1}{\nano \second } bin per event. The left panel uses a linear ordinate and the right a logarithmic one; all four configurations are drawn on each panel (the prompt peaks of configs~1--3 nearly coincide and extend above the linear range). The integrated mean yields are \num {518.8}, \num {274.0}, \num {140.2} and \num {67.5} photoelectrons per event for configs~1--4. The WLS layout (config~4) peaks roughly \SI {6.0}{\nano \second } later than the others and retains a long, slowly-decaying tail, the average-waveform counterpart of the persistence map}{figure.caption.37}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {28}{\ignorespaces Detected wavelength versus arrival time, one panel per layout (glossy paper, whole-plate irradiation), on a shared logarithmic colour scale (number of photoelectrons). Configurations~1--3 populate a narrow band around the \SI {457}{\nano \meter } blue scintillation spectrum; config~4 is green-shifted by the Y-11 WLS fibres. The time dependence of the mean wavelength traces the self-absorption of the shorter-wavelength light over the multi-bounce path (from \SI {450.9}{\nano \meter } to \SI {467.7}{\nano \meter } in configs~1--3 and from \SI {499.1}{\nano \meter } to \SI {511.3}{\nano \meter } in config~4, between the early and late arrival windows).}}{45}{figure.caption.38}\protected@file@percent }
\newlabel{fig:wltime}{{28}{45}{Detected wavelength versus arrival time, one panel per layout (glossy paper, whole-plate irradiation), on a shared logarithmic colour scale (number of photoelectrons). Configurations~1--3 populate a narrow band around the \SI {457}{\nano \meter } blue scintillation spectrum; config~4 is green-shifted by the Y-11 WLS fibres. The time dependence of the mean wavelength traces the self-absorption of the shorter-wavelength light over the multi-bounce path (from \SI {450.9}{\nano \meter } to \SI {467.7}{\nano \meter } in configs~1--3 and from \SI {499.1}{\nano \meter } to \SI {511.3}{\nano \meter } in config~4, between the early and late arrival windows)}{figure.caption.38}{}}
