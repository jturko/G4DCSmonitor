\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Optical property tables used by the simulation. \emph  {Left:} normalised spectral shapes of the PVT scintillator emission (peaking at \SI {425}{\nano \meter }) and of the digitized Y-11 WLS fibre absorption (\SI {430}{\nano \meter }) and re-emission (\SI {476}{\nano \meter }); the absorption/emission overlap is the input to the \texttt  {G4OpWLS} energy constraint $E_\gamma ' \le E_\gamma $. \emph  {Middle:} attenuation lengths on a logarithmic scale---the scintillator bulk absorption and the fibre WLS absorption (absolute scale set to \SI {1}{\milli \meter } at the \SI {430}{\nano \meter } peak). \emph  {Right:} SiPM photocathode PDE$(\lambda )$, the digitized curve peaking at \SI {410}{\nano \meter }. The vertical dashed line in each panel marks the characteristic wavelength of that panel's process---the scintillator emission peak at \SI {425}{\nano \meter } and the Y-11 emission peak at \SI {476}{\nano \meter } (left), the WLS absorption onset at \SI {486}{\nano \meter } (middle), and the SiPM PDE peak at \SI {410}{\nano \meter } (right); the scintillator emission peak and the SiPM PDE peak therefore nearly coincide, whereas the WLS absorption onset and the Y-11 emission peak are red-shifted into the WLS band. Markers are the tabulated points; segments are the linear interpolation Geant4\ applies.}}{14}{figure.caption.7}\protected@file@percent }
\newlabel{fig:spectra_opt}{{4}{14}{Optical property tables used by the simulation. \emph {Left:} normalised spectral shapes of the PVT scintillator emission (peaking at \SI {425}{\nano \meter }) and of the digitized Y-11 WLS fibre absorption (\SI {430}{\nano \meter }) and re-emission (\SI {476}{\nano \meter }); the absorption/emission overlap is the input to the \texttt {G4OpWLS} energy constraint $E_\gamma ' \le E_\gamma $. \emph {Middle:} attenuation lengths on a logarithmic scale---the scintillator bulk absorption and the fibre WLS absorption (absolute scale set to \SI {1}{\milli \meter } at the \SI {430}{\nano \meter } peak). \emph {Right:} SiPM photocathode PDE$(\lambda )$, the digitized curve peaking at \SI {410}{\nano \meter }. The vertical dashed line in each panel marks the characteristic wavelength of that panel's process---the scintillator emission peak at \SI {425}{\nano \meter } and the Y-11 emission peak at \SI {476}{\nano \meter } (left), the WLS absorption onset at \SI {486}{\nano \meter } (middle), and the SiPM PDE peak at \SI {410}{\nano \meter } (right); the scintillator emission peak and the SiPM PDE peak therefore nearly coincide, whereas the WLS absorption onset and the Y-11 emission peak are red-shifted into the WLS band. Markers are the tabulated points; segments are the linear interpolation \gfour \ applies}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Time structure of the two optical sources. \emph  {Left:} the PVT scintillation pulse $f(t) \propto \bigl  (1-e^{-t/\tau _r}\bigr  )e^{-t/\tau _d}$ with rise $\tau _r = \SI {0.9}{\nano \second }$ and decay $\tau _d = \SI {2.1}{\nano \second }$, normalised to its peak and shown on a linear scale; the dashed line marks the maximum at \SI {1.08}{\nano \second }. The inset (upper-right) replays the same pulse on a logarithmic ordinate, exposing the pure-exponential tail $e^{-t/\tau _d}$. \emph  {Right:} the Y-11 WLS re-emission probability density: exponential with $\tau = \SI {7}{\nano \second }$ used in production (solid), compared with the historical fixed-delay profile at \SI {7}{\nano \second } (dashed). The corresponding spectral tables are in Fig.~\ref {fig:spectra_opt}.}}{15}{figure.caption.8}\protected@file@percent }
\newlabel{fig:opticaltiming}{{5}{15}{Time structure of the two optical sources. \emph {Left:} the PVT scintillation pulse $f(t) \propto \bigl (1-e^{-t/\tau _r}\bigr )e^{-t/\tau _d}$ with rise $\tau _r = \SI {0.9}{\nano \second }$ and decay $\tau _d = \SI {2.1}{\nano \second }$, normalised to its peak and shown on a linear scale; the dashed line marks the maximum at \SI {1.08}{\nano \second }. The inset (upper-right) replays the same pulse on a logarithmic ordinate, exposing the pure-exponential tail $e^{-t/\tau _d}$. \emph {Right:} the Y-11 WLS re-emission probability density: exponential with $\tau = \SI {7}{\nano \second }$ used in production (solid), compared with the historical fixed-delay profile at \SI {7}{\nano \second } (dashed). The corresponding spectral tables are in Fig.~\ref {fig:spectra_opt}}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Reflector treatments. \emph  {Left:} tabulated reflectivity $R(\lambda )$ of the three reflective wrappers (TiO$_2$ paint, aluminium foil, high-gloss paper) on the shared 10-point grid, with the bare plate's lossless total-internal-reflection guide line. \emph  {Middle:} $R$ at the scintillation emission peak (\SI {425}{\nano \meter }). \emph  {Right:} $R$ at the Y-11 emission peak (\SI {476}{\nano \meter }), the wavelength of the config-4 re-emitted light. In both bar panels the bare plate is shown at unity as the TIR ceiling, not as a reflector.}}{15}{figure.caption.9}\protected@file@percent }
\newlabel{fig:reflR}{{6}{15}{Reflector treatments. \emph {Left:} tabulated reflectivity $R(\lambda )$ of the three reflective wrappers (TiO$_2$ paint, aluminium foil, high-gloss paper) on the shared 10-point grid, with the bare plate's lossless total-internal-reflection guide line. \emph {Middle:} $R$ at the scintillation emission peak (\SI {425}{\nano \meter }). \emph {Right:} $R$ at the Y-11 emission peak (\SI {476}{\nano \meter }), the wavelength of the config-4 re-emitted light. In both bar panels the bare plate is shown at unity as the TIR ceiling, not as a reflector}{figure.caption.9}{}}
