\@writefile{lof}{\contentsline {figure}{\numberline {29}{\ignorespaces Per-SiPM arrival-time waveforms of the config-1 read-out for a muon in the centre of the plate and for a muon in the top-right corner, for the two wrappers that behave most differently. Each curve is the mean number of photoelectrons in a \SI {0.2}{\nano \second } bin, averaged over \num {362} (centre) and \num {502} (corner) events of the whole-plate irradiation; the sensor names follow Fig.~\ref {fig:layouts}. For the central muon the eight waveforms lie on top of one another for both wrappers. For the corner muon the diffuse TiO$_2$ paint sends a large and early pulse to the two sensors at that corner (T1, R2) and starves the other six, whereas the specular glossy paper leaves the integrated charges almost untouched but still shifts the corner sensors' pulses to earlier times.}}{47}{figure.caption.39}\protected@file@percent }
\newlabel{fig:recon-wf}{{29}{47}{Per-SiPM arrival-time waveforms of the config-1 read-out for a muon in the centre of the plate and for a muon in the top-right corner, for the two wrappers that behave most differently. Each curve is the mean number of photoelectrons in a \SI {0.2}{\nano \second } bin, averaged over \num {362} (centre) and \num {502} (corner) events of the whole-plate irradiation; the sensor names follow Fig.~\ref {fig:layouts}. For the central muon the eight waveforms lie on top of one another for both wrappers. For the corner muon the diffuse TiO$_2$ paint sends a large and early pulse to the two sensors at that corner (T1, R2) and starves the other six, whereas the specular glossy paper leaves the integrated charges almost untouched but still shifts the corner sensors' pulses to earlier times}{figure.caption.39}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {30}{\ignorespaces Per-SiPM observables for a central muon (left group of each panel) and a corner muon (right group), for the glossy (top row) and TiO$_2$ (bottom row) wrappers. \emph  {Left column:} light share of each SiPM as the deviation from the uniform $1/8$ expectation, in percentage points. \emph  {Right column:} first-arrival time of each SiPM relative to the mean first-arrival time of the eight channels of the same event, in nanoseconds. The diffuse TiO$_2$ paint shows strong light sharing at the corner (+24 percentage points for T1 and R2) but only a modest timing separation; the specular glossy paper shows the opposite: no light sharing at all, but a clear timing separation of the corner sensors.}}{48}{figure.caption.40}\protected@file@percent }
\newlabel{fig:recon-obs}{{30}{48}{Per-SiPM observables for a central muon (left group of each panel) and a corner muon (right group), for the glossy (top row) and TiO$_2$ (bottom row) wrappers. \emph {Left column:} light share of each SiPM as the deviation from the uniform $1/8$ expectation, in percentage points. \emph {Right column:} first-arrival time of each SiPM relative to the mean first-arrival time of the eight channels of the same event, in nanoseconds. The diffuse TiO$_2$ paint shows strong light sharing at the corner (+24 percentage points for T1 and R2) but only a modest timing separation; the specular glossy paper shows the opposite: no light sharing at all, but a clear timing separation of the corner sensors}{figure.caption.40}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.3}A single linear combination is not enough}{48}{subsection.8.3}\protected@file@percent }
\newlabel{sec:recon-linear}{{8.3}{48}{A single linear combination is not enough}{subsection.8.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces Linear response of the opposite-pair observables of Eq.~\ref {eq:pair} to the interaction position, for the four wrappers ($x$-direction; the $y$-direction is the same by the four-fold symmetry of the layout). The pulse-integral asymmetry $A_x$ is built from the summed photoelectron counts (i.e.\ the integrated charges) of the two channels of each edge. The slope is the fitted response per millimetre, the noise the rms deviation of the observable from the fit, and the implied resolution the quotient of the two. The last column repeats the resolution obtained from the learned estimator of Sec.~\ref {sec:recon-learned} for comparison.}}{49}{table.caption.41}\protected@file@percent }
\newlabel{tab:reconobs}{{11}{49}{Linear response of the opposite-pair observables of Eq.~\ref {eq:pair} to the interaction position, for the four wrappers ($x$-direction; the $y$-direction is the same by the four-fold symmetry of the layout). The pulse-integral asymmetry $A_x$ is built from the summed photoelectron counts (i.e.\ the integrated charges) of the two channels of each edge. The slope is the fitted response per millimetre, the noise the rms deviation of the observable from the fit, and the implied resolution the quotient of the two. The last column repeats the resolution obtained from the learned estimator of Sec.~\ref {sec:recon-learned} for comparison}{table.caption.41}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.4}A learned response function}{49}{subsection.8.4}\protected@file@percent }
