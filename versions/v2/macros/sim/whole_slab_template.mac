# =============================================================================
# MuonScint whole-slab irradiation template  (Rao et al., J. Appl. Phys. 138, 114504)
#
# Vertical 4 GeV muon beam covering the ENTIRE 250 x 250 mm^2 plastic plate,
# used to build a light-collection-efficiency map as a function of the muon
# interaction position (x,y).
#
# Unlike the centre/edge/corner scan, the collection efficiency here is NOT
# stored as histograms: MuonScintSiPMSD writes the primary muon's first-entry
# slab-local x-y (muonX/muonY) and the event's produced optical photons
# (nProduced) into the `sipmHits` tree, together with each SiPM's nDetected.
# The efficiency is then reconstructed offline (nDetected / nProduced) at any
# cell size and for any SiPM subset -- see macros/plot_collection_efficiency.C.
#
#   CONFIG    : 1 = 8 SiPMs (2/side), 2 = 4 SiPMs (1/side at the Config-1
#               offsets), 3 = 2 SiPMs (both on the -X side),
#               4 = single SiPM + WLS fibre clamp on the -X side (preset 5)
#   REFLECTOR : 0 = none (held in black holder), 1 = TiO2 paint,
#               2 = aluminium foil, 3 = high-gloss paper
#
# This file is a SLURM-standalone copy generated by generate_whole_slab.sh --
# edit this template, not the generated macros.
# =============================================================================

/run/numberOfThreads @THREADS@

# ---- geometry: plate + SiPM layout + reflector ------------------------------
/dcs-monitor/det/setPosition 0 0 0 mm
/dcs-monitor/det/setRotation 0 0 0
/dcs-monitor/det/muonScint/add
/dcs-monitor/det/muonScint/setSize 250 250 10 mm
/dcs-monitor/det/muonScint/preset @PRESET@
/dcs-monitor/det/muonScint/setReflector @REFLECTOR@
/dcs-monitor/det/muonScint/setWrap true

/run/initialize

# ---- primary: vertical 4 GeV muon over the full 250 x 250 mm^2 plate --------
# GPS "planar" flux fires the default momentum direction (0,0,-1): a vertical
# beam normal to the plate. halfx/halfy = 125 mm covers the full slab, so the
# primary muon's first-entry x-y is sampled uniformly over [-125,+125] mm^2.
/dcs-monitor/gun/sourceMode GPS
/gps/particle mu-
/gps/ene/type Mono
/gps/ene/mono 4 GeV
/gps/pos/type Plane
/gps/pos/shape Square
/gps/pos/centre 0 0 100 mm
/gps/pos/halfx 125 mm
/gps/pos/halfy 125 mm
/gps/ang/type planar

# ---- output -----------------------------------------------------------------
/analysis/setFileName @DATADIR@/muon_whole_out_c@CONFIG@_r@REFLECTOR@.root

/run/beamOn @NEVENTS@
