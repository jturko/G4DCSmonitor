# =============================================================================
# MuonScint characterization template -- bare contact + Al backing scans
#
# Same 250 x 250 x 10 mm^3 plate and 50 x 50 mm^2 vertical 4 GeV muon beam as
# muon_scint_template.mac, but with the two new pre-init knobs:
#
#   @BARECONTACT@ : effective bare-plate/black-holder contact fraction (0..1)
#   @ALBACKING@   : Al-foil backing index, "grease" (n=1.46) or "air" (1.0003)
#
# One macro runs centre/edge/corner back-to-back after a single
# /run/initialize, exactly like the matrix template.  The generator writes each
# case into its own @DATADIR@ subdirectory so the standard
# muon_out_c<C>_r<R>_<pos>.root names stay compatible with analyze_muon.C.
#
# @FLUXMAP@ is replaced by the flux-map command for the heavy template or by a
# comment for the fast template.  The characterization scans default to the
# fast variant (flux map off); the yield comes from the sipmHits tree.
#
# This file is a template.  Edit this, not the generated macros.
# =============================================================================

/run/numberOfThreads @THREADS@

# ---- geometry: plate + SiPM layout + reflector ------------------------------
/dcs-monitor/det/setPosition 0 0 0 mm
/dcs-monitor/det/setRotation 0 0 0
/dcs-monitor/det/muonScint/add
/dcs-monitor/det/muonScint/setSize 250 250 10 mm
/dcs-monitor/det/muonScint/preset @PRESET@
/dcs-monitor/det/muonScint/setReflector @REFLECTOR@
/dcs-monitor/det/muonScint/setWrap true
/dcs-monitor/det/muonScint/setBareContactFraction @BARECONTACT@
/dcs-monitor/det/muonScint/setAlBacking @ALBACKING@

/run/initialize

# ---- optional per-slab optical-photon x-y track-length flux map ------------
@FLUXMAP@

# ---- primary: vertical 4 GeV muon, 50 x 50 mm^2 beam ------------------------
/dcs-monitor/gun/sourceMode GPS
/gps/particle mu-
/gps/ene/type Mono
/gps/ene/mono 4 GeV
/gps/pos/type Plane
/gps/pos/shape Square
/gps/pos/halfx 25 mm
/gps/pos/halfy 25 mm
/gps/ang/type planar

# ---- position 1/3: centre ---------------------------------------------------
/analysis/setFileName @DATADIR@/muon_out_c@CONFIG@_r@REFLECTOR@_centre.root
/gps/pos/centre 0 0 100 mm
/run/beamOn @NEVENTS@

# ---- position 2/3: edge (middle of +X side, fully on the slab) --------------
/analysis/setFileName @DATADIR@/muon_out_c@CONFIG@_r@REFLECTOR@_edge.root
/gps/pos/centre 100 0 100 mm
/run/beamOn @NEVENTS@

# ---- position 3/3: corner (+X/+Y, fully on the slab) ------------------------
/analysis/setFileName @DATADIR@/muon_out_c@CONFIG@_r@REFLECTOR@_corner.root
/gps/pos/centre 100 100 100 mm
/run/beamOn @NEVENTS@
